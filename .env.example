NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# PostgreSQL (docker-compose service `postgres` on host port 5432)
DATABASE_URL=postgresql://tarweej:tarweej_dev_password@localhost:5432/tarweej?schema=public

# Redis (docker-compose service `redis` on host port 6379)
REDIS_URL=redis://localhost:6379

# Object storage: local (default, filesystem) or s3 (MinIO/AWS)
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_ROOT=.data/object-storage
OBJECT_STORAGE_PUBLIC_BASE_URL=http://localhost:3000/api/v1/media
# MinIO / S3-compatible object storage (docker-compose service `minio`)
# API: http://localhost:9000  Console: http://localhost:9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tarweej_minio
S3_SECRET_KEY=tarweej_minio_dev_password
S3_BUCKET=tarweej-dev
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
LOG_LEVEL=debug
# LOG_FORMAT=pretty   # production defaults to json; set pretty for local
# ENABLE_SWAGGER=true # swagger is on in non-production; off in production unless true

# Identity / JWT (use strong unique secrets in non-dev environments; never commit real secrets)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

# Phone OTP (provider-agnostic; SMS_PROVIDER=mock for local — forbidden in production)
SMS_PROVIDER=mock
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=60
OTP_RATE_LIMIT_MAX=3
OTP_CODE_LENGTH=6

# HTTP auth route rate limits (register/login/refresh/google/otp)
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=30

# Google auth adapter (disabled by default; enable when client id is configured)
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# Payments (mock/sandbox adapter for local; never commit production PSP secrets)
PAYMENT_MOCK_WEBHOOK_SECRET=dev-mock-payment-webhook-secret

# Admin (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
