NODE_ENV=development
PORT=3000
API_PREFIX=api
API_VERSION=1

# PostgreSQL (docker-compose service `postgres` on host port 5432)
DATABASE_URL=postgresql://tarweej:tarweej_dev_password@localhost:5432/tarweej?schema=public

# Redis (docker-compose service `redis` on host port 6379)
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible object storage (docker-compose service `minio`)
# API: http://localhost:9000  Console: http://localhost:9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=tarweej_minio
S3_SECRET_KEY=tarweej_minio_dev_password
S3_BUCKET=tarweej-dev
S3_FORCE_PATH_STYLE=true

CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
LOG_LEVEL=debug

# Admin (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000/api/v1
