// Tarweej schema (Identity + Reference + Config/Admin RBAC + Catalog + Listings +
// Engagement + Commercial/Payments).
// UUID PKs use DB gen_random_uuid() defaults (TRW-002 user default).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

model User {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                 String?   @unique @db.VarChar(320)
  phoneE164             String?   @unique @map("phone_e164") @db.VarChar(20)
  passwordHash          String?   @map("password_hash") @db.VarChar(255)
  accountType           String    @default("regular") @map("account_type") @db.VarChar(40)
  status                String    @default("active") @db.VarChar(40)
  countryId             String?   @map("country_id") @db.Uuid
  preferredLanguageCode String?   @map("preferred_language_code") @db.VarChar(16)
  displayName           String?   @map("display_name") @db.VarChar(160)
  emailVerifiedAt       DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt       DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)

  country         Country?             @relation(fields: [countryId], references: [id])
  sessions        UserSession[]
  oauthAccounts   UserOauthAccount[]
  roleAssignments UserRoleAssignment[]
  auditEntries    AuditEntry[]
  listings        Listing[]
  listingStatusChanges ListingStatusHistory[]
  listingViews    ListingView[]
  favorites       Favorite[]
  conversationsAsBuyer  Conversation[] @relation("ConversationBuyer")
  conversationsAsSeller Conversation[] @relation("ConversationSeller")
  messages        Message[]
  payments        Payment[]

  @@index([countryId])
  @@index([status])
  @@map("users")
}

model UserSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash") @db.VarChar(255)
  deviceLabel      String?   @map("device_label") @db.VarChar(160)
  userAgent        String?   @map("user_agent") @db.VarChar(512)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  lastSeenAt       DateTime? @map("last_seen_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

/// Phone OTP challenges (SMS/WhatsApp provider-agnostic).
model PhoneOtpChallenge {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneE164       String    @map("phone_e164") @db.VarChar(20)
  codeHash        String    @map("code_hash") @db.VarChar(255)
  purpose         String    @default("login") @db.VarChar(40)
  attemptCount    Int       @default(0) @map("attempt_count")
  maxAttempts     Int       @default(5) @map("max_attempts")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt      DateTime? @map("consumed_at") @db.Timestamptz(6)
  lastSentAt      DateTime  @default(now()) @map("last_sent_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([phoneE164, purpose])
  @@index([expiresAt])
  @@map("phone_otp_challenges")
}

model UserOauthAccount {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  provider        String   @db.VarChar(40)
  providerSubject String   @map("provider_subject") @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSubject])
  @@index([userId])
  @@map("user_oauth_accounts")
}

model Role {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(64)
  name        String  @db.VarChar(120)
  description String? @db.VarChar(255)

  assignments UserRoleAssignment[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String  @unique @db.VarChar(120)
  name        String  @db.VarChar(160)
  description String? @db.VarChar(255)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRoleAssignment {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([roleId])
  @@map("user_role_assignments")
}

// ---------------------------------------------------------------------------
// Reference data
// Association tables are source of truth for country↔language/locale/currency/
// time_zone/dialing_code (with is_primary). Partial unique indexes enforce one
// primary association per country (see migrations).
// ---------------------------------------------------------------------------

model Language {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code     String  @unique @db.VarChar(16)
  name     String  @db.VarChar(120)
  isRtl    Boolean @default(false) @map("is_rtl")
  isActive Boolean @default(true) @map("is_active")

  locales          Locale[]
  countryLanguages CountryLanguage[]

  @@map("languages")
}

/// BCP-47 locale (e.g. ar-SA, en). Linked to a language; country associations are SoT.
model Locale {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String  @unique @db.VarChar(32)
  languageId String  @map("language_id") @db.Uuid
  name       String  @db.VarChar(120)
  isActive   Boolean @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  language        Language        @relation(fields: [languageId], references: [id], onDelete: Restrict)
  countryLocales  CountryLocale[]

  @@index([languageId])
  @@map("locales")
}

model Country {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  iso2        String   @unique @db.Char(2)
  iso3        String   @unique @db.Char(3)
  /// Denormalized from primary country_dialing_codes for convenient display.
  dialingCode String   @map("dialing_code") @db.VarChar(8)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users               User[]
  countryLanguages    CountryLanguage[]
  countryLocales      CountryLocale[]
  countryCurrencies   CountryCurrency[]
  countryTimeZones    CountryTimeZone[]
  countryDialingCodes CountryDialingCode[]
  regions               Region[]
  listings              Listing[]
  featuredPricingRules  FeaturedPricingRule[]
  paymentProviderRoutes PaymentProviderRoute[]

  @@map("countries")
}

model Currency {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code       String  @unique @db.VarChar(8)
  name       String  @db.VarChar(120)
  minorUnits Int     @default(2) @map("minor_units")
  isActive   Boolean @default(true) @map("is_active")

  countryCurrencies CountryCurrency[]

  @@map("currencies")
}

model TimeZone {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ianaName String @unique @map("iana_name") @db.VarChar(64)

  countryTimeZones CountryTimeZone[]

  @@map("time_zones")
}

/// International dialing prefixes (e.g. +966). Country links via association SoT.
model DialingCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code      String   @unique @db.VarChar(8)
  label     String?  @db.VarChar(120)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  countryDialingCodes CountryDialingCode[]

  @@map("dialing_codes")
}

model CountryLanguage {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId  String  @map("country_id") @db.Uuid
  languageId String  @map("language_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  language Language @relation(fields: [languageId], references: [id], onDelete: Cascade)

  @@unique([countryId, languageId])
  @@index([languageId])
  @@map("country_languages")
}

model CountryLocale {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId String  @map("country_id") @db.Uuid
  localeId  String  @map("locale_id") @db.Uuid
  isPrimary Boolean @default(false) @map("is_primary")

  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  locale  Locale  @relation(fields: [localeId], references: [id], onDelete: Cascade)

  @@unique([countryId, localeId])
  @@index([localeId])
  @@map("country_locales")
}

model CountryCurrency {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId  String  @map("country_id") @db.Uuid
  currencyId String  @map("currency_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  currency Currency @relation(fields: [currencyId], references: [id], onDelete: Cascade)

  @@unique([countryId, currencyId])
  @@index([currencyId])
  @@map("country_currencies")
}

model CountryTimeZone {
  id         String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId  String  @map("country_id") @db.Uuid
  timeZoneId String  @map("time_zone_id") @db.Uuid
  isPrimary  Boolean @default(false) @map("is_primary")

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  timeZone TimeZone @relation(fields: [timeZoneId], references: [id], onDelete: Cascade)

  @@unique([countryId, timeZoneId])
  @@index([timeZoneId])
  @@map("country_time_zones")
}

model CountryDialingCode {
  id            String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId     String  @map("country_id") @db.Uuid
  dialingCodeId String  @map("dialing_code_id") @db.Uuid
  isPrimary     Boolean @default(false) @map("is_primary")

  country     Country     @relation(fields: [countryId], references: [id], onDelete: Cascade)
  dialingCode DialingCode @relation(fields: [dialingCodeId], references: [id], onDelete: Cascade)

  @@unique([countryId, dialingCodeId])
  @@index([dialingCodeId])
  @@map("country_dialing_codes")
}

/// Hierarchical geo region (parent_id adjacency). Translations via translation_strings.
model Region {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId String   @map("country_id") @db.Uuid
  parentId  String?  @map("parent_id") @db.Uuid
  code      String   @db.VarChar(40)
  name      String   @db.VarChar(160)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  country  Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  parent   Region?  @relation("RegionTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Region[] @relation("RegionTree")
  cities   City[]

  @@unique([countryId, code])
  @@index([parentId])
  @@index([countryId, isActive])
  @@map("regions")
}

model City {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionId  String   @map("region_id") @db.Uuid
  name      String   @db.VarChar(160)
  latitude  Float?
  longitude Float?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  region   Region    @relation(fields: [regionId], references: [id], onDelete: Cascade)
  listings Listing[]

  @@index([regionId, isActive])
  @@map("cities")
}

/// Polymorphic translations for country/region/city (and other) display fields.
model TranslationString {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entityType   String @map("entity_type") @db.VarChar(64)
  entityId     String @map("entity_id") @db.Uuid
  languageCode String @map("language_code") @db.VarChar(16)
  fieldName    String @map("field_name") @db.VarChar(64)
  value        String @db.Text

  @@unique([entityType, entityId, languageCode, fieldName])
  @@index([entityType, entityId])
  @@map("translation_strings")
}

// ---------------------------------------------------------------------------
// Configuration / admin (TRW-005)
// ---------------------------------------------------------------------------

model FeatureFlag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String?  @db.VarChar(255)
  isEnabled   Boolean  @default(false) @map("is_enabled")
  rulesJson   Json?    @map("rules_json") @db.JsonB
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("feature_flags")
}

model BusinessSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(120)
  description String?  @db.VarChar(255)
  valueJson   Json     @map("value_json") @db.JsonB
  /// When true, value is never returned on public client endpoints.
  isSecret    Boolean  @default(false) @map("is_secret")
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([isSecret])
  @@map("business_settings")
}

/// Append-only audit trail for sensitive admin mutations (ADR-005).
model AuditEntry {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id") @db.Uuid
  beforeJson Json?    @map("before_json") @db.JsonB
  afterJson  Json?    @map("after_json") @db.JsonB
  metadata   Json?    @db.JsonB
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_entries")
}

// ---------------------------------------------------------------------------
// Catalog — categories & dynamic attributes (TRW-006)
// Translations for category / attribute / option display names use
// translation_strings (entity_type: category | attribute_definition | attribute_option).
// ---------------------------------------------------------------------------

/// Hierarchical category tree (adjacency list). Soft-delete via deleted_at.
model Category {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parentId    String?   @map("parent_id") @db.Uuid
  slug        String    @unique @db.VarChar(120)
  name        String    @db.VarChar(160)
  /// Vertical seam (marketplace, services, jobs, motors, real_estate, …).
  listingType String    @default("marketplace") @map("listing_type") @db.VarChar(40)
  sortOrder   Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(6)

  parent     Category?           @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Category[]          @relation("CategoryTree")
  attributes CategoryAttribute[]
  listings   Listing[]

  @@index([parentId])
  @@index([listingType, isActive])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("categories")
}

/// Reusable attribute definition (data type + validation).
model AttributeDefinition {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code           String   @unique @db.VarChar(80)
  name           String   @db.VarChar(160)
  /// text | number | int | decimal | single_select | multi_select | bool | date | numeric_range | unit
  dataType       String   @map("data_type") @db.VarChar(40)
  unit           String?  @db.VarChar(40)
  isRequired     Boolean  @default(false) @map("is_required")
  validationJson Json?    @map("validation_json") @db.JsonB
  sortOrder      Int      @default(0) @map("sort_order")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  categoryLinks CategoryAttribute[]
  options       AttributeOption[]
  listingValues ListingAttributeValue[]

  @@index([dataType])
  @@index([isActive])
  @@map("attribute_definitions")
}

/// M2M association: which attributes apply to a category (SoT).
model CategoryAttribute {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId            String   @map("category_id") @db.Uuid
  attributeDefinitionId String   @map("attribute_definition_id") @db.Uuid
  /// When set, overrides AttributeDefinition.isRequired for this category.
  isRequiredOverride    Boolean? @map("is_required_override")
  sortOrder             Int      @default(0) @map("sort_order")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category            Category            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([categoryId, attributeDefinitionId])
  @@index([attributeDefinitionId])
  @@index([categoryId, sortOrder])
  @@map("category_attributes")
}

/// Select-type options for an attribute definition.
model AttributeOption {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  attributeDefinitionId String   @map("attribute_definition_id") @db.Uuid
  value                 String   @db.VarChar(120)
  label                 String   @db.VarChar(160)
  sortOrder             Int      @default(0) @map("sort_order")
  isActive              Boolean  @default(true) @map("is_active")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Cascade)

  @@unique([attributeDefinitionId, value])
  @@index([attributeDefinitionId, sortOrder])
  @@map("attribute_options")
}

// ---------------------------------------------------------------------------
// Listings (TRW-007)
// Media bytes live in object storage; Postgres stores metadata + keys only.
// ---------------------------------------------------------------------------

model Listing {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String    @map("owner_id") @db.Uuid
  categoryId       String    @map("category_id") @db.Uuid
  countryId        String    @map("country_id") @db.Uuid
  cityId           String?   @map("city_id") @db.Uuid
  listingType      String    @default("marketplace") @map("listing_type") @db.VarChar(40)
  title            String    @db.VarChar(200)
  description      String    @db.Text
  priceAmount      Decimal?  @map("price_amount") @db.Decimal(18, 4)
  currencyCode     String?   @map("currency_code") @db.VarChar(3)
  status           String    @default("draft") @db.VarChar(40)
  isFeaturedCached Boolean   @default(false) @map("is_featured_cached")
  viewCount        Int       @default(0) @map("view_count")
  latitude         Float?
  longitude        Float?
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  expiresAt        DateTime? @map("expires_at") @db.Timestamptz(6)
  rejectionReason  String?   @map("rejection_reason") @db.VarChar(500)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz(6)

  owner            User                     @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  category         Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  country          Country                  @relation(fields: [countryId], references: [id], onDelete: Restrict)
  city             City?                    @relation(fields: [cityId], references: [id], onDelete: SetNull)
  media            ListingMedia[]
  attributeValues  ListingAttributeValue[]
  statusHistory    ListingStatusHistory[]
  views            ListingView[]
  favorites        Favorite[]
  conversations    Conversation[]
  featuredPromotions FeaturedPromotion[]

  @@index([ownerId, status])
  @@index([status, countryId, publishedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([deletedAt])
  @@index([cityId, status])
  @@index([status, priceAmount])
  @@index([status, isFeaturedCached, publishedAt(sort: Desc)])
  @@index([status, viewCount(sort: Desc)])
  @@map("listings")
}

model ListingMedia {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  storageKey String   @map("storage_key") @db.VarChar(512)
  cdnUrl     String   @map("cdn_url") @db.VarChar(1024)
  mimeType   String   @map("mime_type") @db.VarChar(120)
  byteSize   Int?     @map("byte_size")
  sortOrder  Int      @default(0) @map("sort_order")
  status     String   @default("ready") @db.VarChar(40)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId, sortOrder])
  @@index([storageKey])
  @@map("listing_media")
}

model ListingAttributeValue {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId             String    @map("listing_id") @db.Uuid
  attributeDefinitionId String    @map("attribute_definition_id") @db.Uuid
  valueText             String?   @map("value_text") @db.VarChar(500)
  valueNumber           Decimal?  @map("value_number") @db.Decimal(18, 6)
  valueBool             Boolean?  @map("value_bool")
  valueDate             DateTime? @map("value_date") @db.Date
  valueJson             Json?     @map("value_json") @db.JsonB
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing             Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  attributeDefinition AttributeDefinition @relation(fields: [attributeDefinitionId], references: [id], onDelete: Restrict)

  @@unique([listingId, attributeDefinitionId])
  @@index([attributeDefinitionId])
  @@index([attributeDefinitionId, valueText])
  @@index([attributeDefinitionId, valueNumber])
  @@index([attributeDefinitionId, valueBool])
  @@map("listing_attribute_values")
}

model ListingStatusHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId  String   @map("listing_id") @db.Uuid
  fromStatus String?  @map("from_status") @db.VarChar(40)
  toStatus   String   @map("to_status") @db.VarChar(40)
  actorId    String?  @map("actor_id") @db.Uuid
  reason     String?  @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([actorId])
  @@map("listing_status_histories")
}

/// Append-only view events; listings.view_count is the denormalized counter.
model ListingView {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId         String   @map("listing_id") @db.Uuid
  viewerId          String?  @map("viewer_id") @db.Uuid
  viewerFingerprint String?  @map("viewer_fingerprint") @db.VarChar(120)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewer  User?   @relation(fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt])
  @@index([viewerId])
  @@map("listing_views")
}

// ---------------------------------------------------------------------------
// Engagement — Favorites & Chat (TRW-009)
// Conversations are listing-scoped (buyer + seller). Messages carry read receipts.
// Realtime delivery is ported (HTTP now; WebSocket gateway stub ready).
// ---------------------------------------------------------------------------

model Favorite {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  listingId String   @map("listing_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([userId, listingId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([listingId])
  @@map("favorites")
}

model Conversation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId     String    @map("listing_id") @db.Uuid
  buyerId       String    @map("buyer_id") @db.Uuid
  sellerId      String    @map("seller_id") @db.Uuid
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing  Listing   @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer    User      @relation("ConversationBuyer", fields: [buyerId], references: [id], onDelete: Restrict)
  seller   User      @relation("ConversationSeller", fields: [sellerId], references: [id], onDelete: Restrict)
  messages Message[]

  @@unique([listingId, buyerId, sellerId])
  @@index([buyerId, lastMessageAt(sort: Desc)])
  @@index([sellerId, lastMessageAt(sort: Desc)])
  @@index([listingId])
  @@map("conversations")
}

model Message {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String    @map("sender_id") @db.Uuid
  body           String    @db.VarChar(4000)
  readAt         DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([conversationId, readAt])
  @@map("messages")
}

// ---------------------------------------------------------------------------
// Commercial — Featured promotions & Payments (TRW-010)
// Financial rows are never hard-deleted (ADR-005). Featured windows are SoT;
// listings.is_featured_cached is a denormalized read optimization.
// ---------------------------------------------------------------------------

model FeaturedPricingRule {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId            String   @map("country_id") @db.Uuid
  currencyCode         String   @map("currency_code") @db.VarChar(3)
  placement            String   @default("home") @db.VarChar(40)
  pricePerHour         Decimal  @map("price_per_hour") @db.Decimal(18, 4)
  maxSlots             Int      @default(7) @map("max_slots")
  defaultDurationHours Int      @default(24) @map("default_duration_hours")
  minDurationHours     Int      @default(1) @map("min_duration_hours")
  maxDurationHours     Int      @default(168) @map("max_duration_hours")
  rankWeight           Int      @default(100) @map("rank_weight")
  isActive             Boolean  @default(true) @map("is_active")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  country     Country              @relation(fields: [countryId], references: [id], onDelete: Restrict)
  promotions  FeaturedPromotion[]

  @@unique([countryId, placement, currencyCode])
  @@index([countryId, isActive])
  @@index([placement, isActive])
  @@map("featured_pricing_rules")
}

model FeaturedPromotion {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId     String    @map("listing_id") @db.Uuid
  paymentId     String    @unique @map("payment_id") @db.Uuid
  pricingRuleId String    @map("pricing_rule_id") @db.Uuid
  placement     String    @db.VarChar(40)
  status        String    @default("scheduled") @db.VarChar(40)
  rankWeight    Int       @default(100) @map("rank_weight")
  durationHours Int       @map("duration_hours")
  startsAt      DateTime? @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime? @map("ends_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  listing     Listing             @relation(fields: [listingId], references: [id], onDelete: Restrict)
  payment     Payment             @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  pricingRule FeaturedPricingRule @relation(fields: [pricingRuleId], references: [id], onDelete: Restrict)

  @@index([listingId, status])
  @@index([status, endsAt])
  @@index([status, placement, startsAt, endsAt])
  @@index([pricingRuleId])
  @@map("featured_promotions")
}

model Payment {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  purpose           String    @db.VarChar(40)
  amount            Decimal   @db.Decimal(18, 4)
  currencyCode      String    @map("currency_code") @db.VarChar(3)
  status            String    @default("pending") @db.VarChar(40)
  providerCode      String    @map("provider_code") @db.VarChar(40)
  idempotencyKey    String    @unique @map("idempotency_key") @db.VarChar(120)
  providerReference String?   @map("provider_reference") @db.VarChar(255)
  countryId         String?   @map("country_id") @db.Uuid
  failureReason     String?   @map("failure_reason") @db.VarChar(500)
  paidAt            DateTime? @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  attempts     PaymentAttempt[]
  webhookEvents WebhookEvent[]
  promotion    FeaturedPromotion?

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([providerCode, providerReference])
  @@map("payments")
}

model PaymentAttempt {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId        String   @map("payment_id") @db.Uuid
  providerStatus   String   @map("provider_status") @db.VarChar(40)
  rawRequestMeta   Json?    @map("raw_request_meta") @db.JsonB
  rawResponseMeta  Json?    @map("raw_response_meta") @db.JsonB
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId, createdAt])
  @@map("payment_attempts")
}

model WebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  providerCode    String    @map("provider_code") @db.VarChar(40)
  providerEventId String    @unique @map("provider_event_id") @db.VarChar(255)
  paymentId       String?   @map("payment_id") @db.Uuid
  signatureValid  Boolean   @map("signature_valid")
  payload         Json      @db.JsonB
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([providerCode, createdAt])
  @@map("webhook_events")
}

model PaymentProviderRoute {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId    String   @map("country_id") @db.Uuid
  providerCode String   @map("provider_code") @db.VarChar(40)
  priority     Int      @default(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  country Country @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@unique([countryId, providerCode])
  @@index([countryId, isActive, priority])
  @@map("payment_provider_routes")
}
