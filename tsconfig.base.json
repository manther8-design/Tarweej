{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@tarweej/api/*": ["apps/api/src/*"],
      "@tarweej/contracts": ["libs/contracts/src/index.ts"],
      "@tarweej/config": ["libs/config/src/index.ts"],
      "@tarweej/logging": ["libs/logging/src/index.ts"],
      "@tarweej/database": ["libs/database/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp", "apps/admin", "apps/mobile", "apps/web"]
}
