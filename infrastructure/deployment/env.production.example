# Production environment template — copy to a secret store / .env.production
# NEVER commit real values. NEVER reuse development placeholders.

NODE_ENV=production
PORT=3000
API_PREFIX=api
API_VERSION=1

# Strong secrets only (min 32 chars, unique access vs refresh)
JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
BCRYPT_ROUNDS=12

DATABASE_URL=postgresql://tarweej:REPLACE_ME@postgres:5432/tarweej?schema=public
REDIS_URL=redis://redis:6379

# Postgres container (compose)
POSTGRES_USER=tarweej
POSTGRES_PASSWORD=REPLACE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=tarweej

OBJECT_STORAGE_DRIVER=s3
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=REPLACE_ME
S3_SECRET_KEY=REPLACE_ME
S3_BUCKET=tarweej-prod
S3_FORCE_PATH_STYLE=true
CDN_BASE_URL=https://cdn.example.com
OBJECT_STORAGE_PUBLIC_BASE_URL=https://cdn.example.com

CORS_ORIGINS=https://admin.example.com,https://app.example.com
LOG_LEVEL=info
LOG_FORMAT=json
# ENABLE_SWAGGER=false  # default off when NODE_ENV=production

SMS_PROVIDER=twilio
# ALLOW_MOCK_PROVIDERS=false

OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_WINDOW_SECONDS=60
OTP_RATE_LIMIT_MAX=3
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=30

GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=

# Payments — set real PSP secrets via secret manager; mock secret must not be used in prod
PAYMENT_MOCK_WEBHOOK_SECRET=

NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/v1
