{
  "name": "tarweej",
  "version": "0.11.0",
  "private": true,
  "description": "Tarweej multi-product marketplace platform monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "nx run api:serve",
    "build": "nx run api:build",
    "build:all": "nx run-many -t build --projects=api,admin,web",
    "lint": "nx run-many -t lint --projects=api",
    "test": "nx run api:test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed/seed.ts",
    "db:studio": "prisma studio",
    "infra:up": "docker compose up -d postgres redis minio",
    "infra:down": "docker compose down",
    "prepare": "husky"
  },
  "prisma": {
    "seed": "tsx prisma/seed/seed.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.28",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.2.0",
    "@prisma/client": "6.16.2",
    "bcryptjs": "^3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "17.2.1",
    "helmet": "8.1.0",
    "ioredis": "^6.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@nestjs/testing": "11.1.28",
    "@nx/eslint": "22.7.5",
    "@nx/eslint-plugin": "22.7.5",
    "@nx/jest": "22.7.5",
    "@nx/js": "22.7.5",
    "@nx/nest": "22.7.5",
    "@nx/node": "22.7.5",
    "@nx/workspace": "22.7.5",
    "@types/bcryptjs": "^3.0.0",
    "@types/express": "5.0.3",
    "@types/jest": "30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "24.1.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.2.1",
    "dotenv-cli": "10.0.0",
    "eslint": "9.32.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "jest": "30.0.5",
    "multer": "^2.5.0",
    "nx": "22.7.5",
    "prettier": "3.6.2",
    "prisma": "6.16.2",
    "supertest": "^7.3.2",
    "ts-jest": "29.4.0",
    "ts-node": "10.9.2",
    "tsx": "4.20.5",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0"
  }
}
